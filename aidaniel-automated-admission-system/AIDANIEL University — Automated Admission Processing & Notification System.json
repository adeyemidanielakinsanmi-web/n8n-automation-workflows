    {
      "parameters": {
        "sendTo": "={{ $('Selection Switch').item.json['Email Address'] }}",
        "subject": "Application Status – AIDANIEL UNIVERSITY OF TECHNOLOGY",
        "emailType": "text",
        "message": "=Dear {{ $json[\"Full Name\"] }},\n\nAPPLICATION STATUS\n\nThank you for applying to AIDANIEL UNIVERSITY OF TECHNOLOGY.\n\nAfter reviewing your application and evaluating your UTME and Pre-Degree scores, we regret to inform you that you did not meet the minimum requirements for admission into either the First Degree Programme or the University School Diploma Programme at this time.\n\nApplication Details:\n\nApplicant ID: {{ $json[\"Applicant ID\"] }}\nProgramme/Course: {{ $json[\"Course\"] }}\nAdmission Status: NOT ADMITTED\n\nWe appreciate your interest in AIDANIEL UNIVERSITY OF TECHNOLOGY and the effort you made during the application process.\n\nWe encourage you to continue pursuing your educational goals and to consider future opportunities that may become available.\n\nWe wish you success in your future academic endeavors.\n\nYours faithfully,\n\nAdmissions Office\nAIDANIEL UNIVERSITY OF TECHNOLOGY",
        "options": {}
      },
