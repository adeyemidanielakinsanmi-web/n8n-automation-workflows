    {
      "parameters": {
        "jsCode": "const HOURS = 4;\nconst now = Date.now();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (r['Status'] !== 'Open') continue;\n  if (String(r['Reminder Sent']).toLowerCase() === 'yes') continue;\n\n  const m = String(r['Date/Time']).match(/(\\d{4}-\\d{2}-\\d{2}) (\\d{2}:\\d{2})/);\n  if (!m) continue;\n\n  const created = new Date(`${m[1]}T${m[2]}:00+01:00`).getTime();\n  const hours = (now - created) / 3600000;\n\n  if (hours >= HOURS) out.push({ json: { ...r, hours_open: Math.floor(hours) } });\n}\n\nreturn out;"
      },
