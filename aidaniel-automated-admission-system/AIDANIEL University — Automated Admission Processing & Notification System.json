    {
      "parameters": {
        "sendTo": "={{ $('Selection Switch').item.json['Email Address'] }}",
        "subject": "Admission Offer – First Degree Programme | AIDANIEL UNIVERSITY OF TECHNOLOGY",
        "emailType": "text",
        "message": "=Dear {{ $json[\"Full Name\"] }},\n\nCONGRATULATIONS!\n\nWe are pleased to inform you that you have been successfully admitted into the First Degree Programme at AIDANIEL UNIVERSITY OF TECHNOLOGY.\n\nYour application has been carefully evaluated based on your UTME and Pre-Degree scores, and you have met the requirements for admission into the First Degree Programme.\n\nAdmission Details:\n\nApplicant ID: {{ $json[\"Applicant ID\"] }}\nProgramme/Course: {{ $json[\"Course\"] }}\nAdmission Status: FIRST DEGREE PROGRAMME\n\nYou are therefore invited to proceed with the necessary admission and registration procedures.\n\nPlease ensure that you follow the University's instructions regarding acceptance, documentation, registration, and payment of applicable fees.\n\nOnce again, congratulations on this achievement. We look forward to welcoming you to AIDANIEL UNIVERSITY OF TECHNOLOGY.\n\nYours faithfully,\n\nAdmissions Office\nAIDANIEL UNIVERSITY OF TECHNOLOGY",
        "options": {}
      },
