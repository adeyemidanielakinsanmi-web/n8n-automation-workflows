      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const q = (($json.Qualifications ?? $json.Qualificatiions) || '').toString().toLowerCase();\nconst hasBsc = /b\\.?\\s*sc/.test(q);\nconst years = Number($json['Years of Experience']) || 0;\nconst meetsExp = years >= 5;\nlet status;\nif (hasBsc && meetsExp) { status = 'Automatically Qualified'; }\nelse if (!hasBsc && !meetsExp) { status = 'Not Qualified'; }\nelse { status = 'Manual Review'; }\nreturn { json: { ...$json, Status: status } };"
