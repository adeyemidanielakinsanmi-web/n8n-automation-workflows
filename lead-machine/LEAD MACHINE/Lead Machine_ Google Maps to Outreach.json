    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Works whether each item is one business or an array of businesses\nconst businesses = items.flatMap(i => Array.isArray(i.json) ? i.json : [i.json]);\n\nconst first = (arr) => (Array.isArray(arr) && arr.length ? arr[0] : null);\n\n// Remove ?utm_... and other query strings from URLs\nconst cleanUrl = (url) => {\n  if (!url) return null;\n  try {\n    const u = new URL(url);\n    return (u.origin + u.pathname).replace(/\\/$/, '');\n  } catch {\n    return url;\n  }\n};\n\nconst seen = new Set();\nconst results = [];\n\nfor (const b of businesses) {\n  // Skip closed businesses and duplicates\n  if (b.permanentlyClosed || b.temporarilyClosed) continue;\n  if (!b.placeId || seen.has(b.placeId)) continue;\n  seen.add(b.placeId);\n\n  const emails = [...new Set((b.emails || []).map(e => e.trim().toLowerCase()))];\n  const dist = b.reviewsDistribution || {};\n  const totalReviews = b.reviewsCount || 0;\n  const negativeReviews = (dist.oneStar || 0) + (dist.twoStar || 0);\n  const negativePct = totalReviews\n    ? Math.round((negativeReviews / totalReviews) * 1000) / 10\n    : null;\n\n  const daysOpen = (b.openingHours || []).filter(h => !/closed/i.test(h.hours)).length;\n\n  const lead = {\n    name: (b.title || '').trim(),\n    category: b.categoryName || null,\n    services: (b.categories || []).join(', '),\n    address: b.address || null,\n    neighborhood: b.neighborhood || null,\n    city: b.city || null,\n    state: b.state || null,\n    postal_code: b.postalCode || null,\n    phone: b.phone || null,\n    email: emails[0] || null,\n    all_emails: emails.join(', '),\n    website: cleanUrl(b.website),\n    domain: b.domain || null,\n    instagram: first(b.instagrams),\n    facebook: first(b.facebooks),\n    linkedin: first(b.linkedIns),\n    twitter: first(b.twitters),\n    tiktok: first(b.tiktoks),\n    youtube: first(b.youtubes),\n    rating: b.totalScore ?? null,\n    reviews_count: totalReviews,\n    negative_reviews_pct: negativePct,\n    days_open_per_week: daysOpen,\n    hours: (b.openingHours || []).map(h => `${h.day}: ${h.hours}`).join(' | '),\n    latitude: b.location?.lat ?? null,\n    longitude: b.location?.lng ?? null,\n    google_maps_url: b.url || null,\n    place_id: b.placeId,\n    search_query: b.searchString || null,\n    scraped_at: b.scrapedAt || null,\n  };\n\n  // Simple lead score (max 100), adjust the weights to your niche\n  let score = 0;\n  if (lead.email) score += 30;\n  if (lead.phone) score += 10;\n  if (lead.website) score += 10;\n  if (lead.instagram) score += 10;\n  if (lead.rating >= 4.5) score += 10;\n  if (lead.reviews_count >= 100) score += 10;\n  if (lead.reviews_count >= 500) score += 10;\n  if (lead.negative_reviews_pct >= 5) score += 10; // possible pain point to pitch\n\n  lead.lead_score = score;\n  lead.lead_tier = score >= 70 ? 'Hot' : score >= 40 ? 'Warm' : 'Cold';\n\n  results.push({ json: lead });\n}\n\nreturn results;"
      },
      "id": "e272c40b-4695-4c29-a198-0e2b330084b0",
      "name": "Clean Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Change 'Switch' to your Switch node's name and 1 to the output feeding the HTTP Request\nconst leads = $('Switch').all(1);\n\nconst BAD = /(\\.(png|jpe?g|gif|svg|webp|avif|ico|css|js|woff2?|ttf|pdf)$)|^(noreply|no-reply|donotreply|mailer-daemon|postmaster|sentry)@|(example\\.com|domain\\.com|sentry\\.io|wixpress\\.com|godaddy\\.com)$/i;\n\nconst findEmail = (html) => {\n  const text = html.replace(/&#64;|&commat;/g, '@').replace(/&amp;/g, '&');\n  const found = new Set();\n  for (const m of text.matchAll(/mailto:([^\"'?>\\s]+)/gi)) found.add(decodeURIComponent(m[1]).toLowerCase());\n  for (const m of text.matchAll(/[a-z0-9._%+-]+@[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.[a-z]{2,}/gi)) found.add(m[0].toLowerCase());\n  return [...found].find(e => !BAD.test(e) && !/@\\d+x\\./.test(e)) || null;\n};\n\nreturn $input.all().map((item, i) => {\n  const j = item.json || {};\n  const l = leads[item.pairedItem?.item ?? i]?.json || {};\n  const base = {\n    business_name: l['Business Name'] ?? l.name ?? l.title ?? null,\n    website: l['Website'] ?? l.website ?? null,\n  };\n\n  // Blocked or failed request: keep a short summary, drop the HTML\n  const raw = typeof j.data === 'string' ? j.data : (j.body || j.details?.body || '');\n  const blocked = j.error || j.details || j.httpCode || /Just a moment\\.\\.\\./.test(raw);\n  if (blocked) {\n    return { json: {\n      ...base,\n      email: null,\n      status: 'blocked',\n      http_code: j.details?.httpCode || j.httpCode || j.error?.status || null,\n      reason: /challenges\\.cloudflare\\.com/.test(raw + (j.details?.description || ''))\n        ? 'Cloudflare challenge' : (j.details?.message || j.error?.message || 'Request failed').slice(0, 80),\n    } };\n  }\n\n  const email = findEmail(raw);\n  return { json: { ...base, email, status: email ? 'ok' : 'no_email_found', http_code: 200, reason: null } };\n});"
      },
