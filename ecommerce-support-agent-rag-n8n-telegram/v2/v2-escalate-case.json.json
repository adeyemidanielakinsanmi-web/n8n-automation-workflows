        "jsCode": "const existing = $('Get existing cases').all().map(i => i.json['Case ID']);\nconst input = $('When Executed by Another Workflow').first().json;\n\nlet id;\ndo {\n  id = 'ESC-' + String(Math.floor(1000 + Math.random() * 9000));\n} while (existing.includes(id));\n\nreturn [{\n  json: {\n    ...input,\n    case_id: id,\n    date_time: $now.setZone('Africa/Lagos').toFormat('yyyy-MM-dd HH:mm'),\n    status: 'Open'\n  }\n}];"
