        "jsCode": "const existing = $('Get existing orders').all().map(i => i.json['Order ID']);\nconst input = $('When Executed by Another Workflow').first().json;\nconst method = String(input.payment_method || '').toLowerCase();\n\nlet id;\ndo {\n  id = 'VHG-' + String(Math.floor(1000 + Math.random() * 9000));\n} while (existing.includes(id));\n\nreturn [{\n  json: {\n    ...input,\n    order_id: id,\n    date_time: $now.setZone('Africa/Lagos').toFormat('yyyy-MM-dd HH:mm'),\n    payment_status: method.includes('paystack') ? 'Awaiting confirmation' : 'Pending',\n    order_status: 'New'\n  }\n}];"
