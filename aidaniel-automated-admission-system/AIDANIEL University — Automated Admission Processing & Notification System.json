    {
      "parameters": {
        "sendTo": "={{ $('Selection Switch').item.json['Email Address'] }}",
        "subject": "Admission Offer – University School Diploma Programme | AIDANIEL UNIVERSITY OF TECHNOLOGY",
        "emailType": "text",
        "message": "=Dear {{ $json[\"Full Name\"] }},\n\nADMISSION OFFER\n\nWe are pleased to inform you that you have been offered admission into the University School Diploma Programme at AIDANIEL UNIVERSITY OF TECHNOLOGY.\n\nYour application has been evaluated based on your UTME and Pre-Degree scores. While your scores do not meet the requirements for direct admission into the First Degree Programme, you have qualified for admission into the University School Diploma Programme.\n\nAdmission Details:\n\nApplicant ID: {{ $json[\"Applicant ID\"] }}\nProgramme/Course: {{ $json[\"Course\"] }}\nAdmission Status: SCHOOL DIPLOMA PROGRAMME\n\nYou are encouraged to take advantage of this opportunity and proceed with the required admission and registration procedures.\n\nPlease follow the University's instructions regarding acceptance, documentation, registration, and payment of applicable fees.\n\nWe congratulate you on your admission and look forward to welcoming you to AIDANIEL UNIVERSITY OF TECHNOLOGY.\n\nYours faithfully,\n\nAdmissions Office\nAIDANIEL UNIVERSITY OF TECHNOLOGY",
        "options": {}
      },
